# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Meta WhatsApp Business API
# From: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# A secret string YOU choose — must match what you enter in Meta's webhook config
WEBHOOK_VERIFY_TOKEN=choose_any_random_string_here

# Your personal WhatsApp number (with country code, digits only, no + or spaces)
# Example: 15551234567 for a US number
OWNER_NUMBER=15551234567

PORT=3000
