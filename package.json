{
  "name": "whatsapp-ai",
  "version": "1.0.0",
  "description": "WhatsApp AI bot powered by Claude — auto-replies, drafts, and escalates messages",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "analyze": "ts-node --transpile-only --skip-project scripts/analyze-chat.ts",
    "tunnel": "ngrok http 3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "localtunnel": "^2.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
